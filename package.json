{
  "name": "the-long-season",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --output-type err packages apps",
    "check:localized-text": "node scripts/check-localized-presentation-text.ts",
    "check:squad-depth": "node scripts/check-squad-depth-accessor.ts",
    "check:role-department": "node scripts/check-role-department-owner.ts",
    "check:single-report-entrypoint": "node scripts/check-single-report-entrypoint.ts",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm lint && pnpm depcruise && pnpm check:localized-text && pnpm check:squad-depth && pnpm check:role-department && pnpm check:single-report-entrypoint && pnpm test && pnpm typecheck",
    "cli": "pnpm --filter @game/cli run cli --",
    "playwright:install": "playwright install chromium",
    "playwright:version": "playwright --version",
    "web:visual:qa": "pnpm --filter @game/web run visual:qa"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "playwright": "^1.61.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
