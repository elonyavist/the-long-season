    "@game/i18n": "workspace:*",
    "@game/shared": "workspace:*",
    "@game/storage": "workspace:*",
    "@game/ui": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.1",
